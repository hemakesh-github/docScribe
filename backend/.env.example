# -----------------------------------------------------------------------------
# docScribe / DocTalk Backend Environment Configuration
# -----------------------------------------------------------------------------

# Sarvam AI API Subscription Key (Get yours from https://dashboard.sarvam.ai)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_API_URL=https://api.sarvam.ai

# AI Models (Configured server-side)
STT_MODEL=saaras:v4
CHAT_MODEL=sarvam-105b
TRANSLATE_MODEL=sarvam-translate:v1
TTS_MODEL=bulbul:v4-flash

# SMTP Email Configuration (Optional - standard mailto works out-of-the-box without this)
# If using Gmail, generate an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=doctor@docscribe.med

# Server
PORT=8000
HOST=0.0.0.0
